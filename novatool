#!/bin/bash
# novatool - Convenience wrapper for the Nova Python toolchain
#
# Usage: ./novatool <command> [args...]
#   or install to PATH and run: novatool <command> [args...]

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON_SCRIPT="$SCRIPT_DIR/scripts/novatool.py"

if [ ! -f "$PYTHON_SCRIPT" ]; then
    echo "Error: novatool.py not found at $PYTHON_SCRIPT" >&2
    exit 1
fi

exec python3 "$PYTHON_SCRIPT" "$@"